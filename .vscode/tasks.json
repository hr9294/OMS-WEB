        {
            "label": "python: run main",
            "type": "shell",
            "command": "python main.py",
            "options": { "cwd": "${workspaceFolder}/OMS_WEB_Python" },
            "problemMatcher": []
        },
        {
            "label": "python: run multi-order",
            "type": "shell",
            "command": "python main.py --mode multi-order",
            "options": { "cwd": "${workspaceFolder}/OMS_WEB_Python" },
            "problemMatcher": []
        }
    ]
}
